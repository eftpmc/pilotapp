{
  "meta": {
    "version": "1.0.0",
    "description": "Pilot design tokens — single source of truth for web (CSS) and iOS (Swift)"
  },

  "color": {
    "base": {
      "bg":        { "light": "#f7f7f5",                      "dark": "#111110" },
      "panel":     { "light": "#ffffff",                      "dark": "#1a1917" },
      "panel2":    { "light": "#f0f0ed",                      "dark": "#222120" },
      "ink":       { "light": "#111110",                      "dark": "#e8e3da" },
      "ink2":      { "light": "#444341",                      "dark": "#aca89f" },
      "muted":     { "light": "#6f6d66",                      "dark": "#7a7770" },
      "faint":     { "light": "#a9a69e",                      "dark": "#504e48" },
      "rule":      { "light": "#ddddda",                      "dark": "rgba(255,255,255,0.09)" },
      "ruleSoft":  { "light": "#e9e9e5",                      "dark": "rgba(255,255,255,0.055)" }
    },
    "brand": {
      "ember":     { "light": "#e5511a",                      "dark": "#ff6b35" },
      "ember2":    { "light": "#c44010",                      "dark": "#ff8c5a" },
      "emberWash": { "light": "#fff3ee",                      "dark": "rgba(255,107,53,0.14)" },
      "onEmber":   { "light": "#ffffff",                      "dark": "#1a0a00" }
    },
    "semantic": {
      "green":     { "light": "#16794a",                      "dark": "#5cc993" },
      "greenDot":  { "light": "#1e9e5c",                      "dark": "#35bb78" },
      "amber":     { "light": "#93611a",                      "dark": "#d9a84e" },
      "amberDot":  { "light": "#c28a1e",                      "dark": "#d49e40" },
      "red":       { "light": "#b22316",                      "dark": "#ee7165" },
      "redDot":    { "light": "#d4432d",                      "dark": "#ec6b5c" }
    }
  },

  "typography": {
    "fontSans": "\"Inter Variable\", system-ui, sans-serif",
    "fontMono": "\"JetBrains Mono Variable\", ui-monospace, monospace",
    "size": {
      "micro":   10,
      "caption": 11,
      "label":   12,
      "body":    14,
      "base":    16,
      "heading": 24
    },
    "weight": {
      "normal":   400,
      "medium":   500,
      "semibold": 600
    },
    "lineHeight": {
      "tight":  1.3,
      "normal": 1.6,
      "mono":   1.85
    }
  },

  "radius": {
    "xs":   4,
    "sm":   6,
    "md":   8,
    "lg":   10,
    "xl":   12,
    "pill": 9999
  },

  "spacing": {
    "1":  2,
    "2":  4,
    "3":  6,
    "4":  8,
    "5":  12,
    "6":  16,
    "7":  20,
    "8":  24,
    "9":  28,
    "10": 32
  },

  "shadow": {
    "sm":     {
      "light": "0 1px 3px rgba(0,0,0,.07), 0 1px 2px rgba(0,0,0,.04)",
      "dark":  "0 1px 0 rgba(255,255,255,0.04), 0 2px 6px rgba(0,0,0,.45)"
    },
    "md":     {
      "light": "0 4px 12px rgba(0,0,0,.10), 0 1px 3px rgba(0,0,0,.06)",
      "dark":  "0 1px 0 rgba(255,255,255,0.04), 0 4px 16px rgba(0,0,0,.55)"
    },
    "dialog": {
      "light": "0 24px 60px rgba(0,0,0,.16), 0 6px 20px rgba(0,0,0,.08)",
      "dark":  "0 24px 80px rgba(0,0,0,.65)"
    }
  }
}
