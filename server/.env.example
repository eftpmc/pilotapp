# Required
JWT_SECRET=change-me-use-a-long-random-string

# Optional — where the SQLite DB and git repos are stored (default: ./data)
DATA_DIR=./data

# Optional — pre-configure API keys server-wide (applies to all users)
# Users can also set per-account keys via Settings in the UI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional
PORT=3000
